set(widget_id org.kooraseru.plasma.audiomanager)
if(DEFINED ENV{XDG_DATA_HOME} AND NOT "$ENV{XDG_DATA_HOME}" STREQUAL "")
    set(user_data "$ENV{XDG_DATA_HOME}")
else()
    set(user_data "$ENV{HOME}/.local/share")
endif()
set(action --install)
if(EXISTS "${user_data}/plasma/plasmoids/${widget_id}/metadata.json")
    set(action --upgrade)
endif()
execute_process(COMMAND "${KPACKAGE_TOOL}" --type Plasma/Applet "${action}"
    "${BUILD_DIR}/${widget_id}.plasmoid" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Audio Manager is available in Plasma's Add Widgets chooser.")
message(STATUS "Start pam-backend separately; no user service or audio configuration is installed.")
